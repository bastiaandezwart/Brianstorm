# Poort waarop de app luistert
PORT=3000

# Gedeelde code waarmee jullie inloggen (sterk aanbevolen zodra de app online staat)
TEAM_CODE=kies-een-lange-geheime-code

# Namen van de partners (optioneel; ook in de app aan te passen)
MEMBER_EA_NAME=Enterprise Architect
MEMBER_PM_NAME=Product Manager
MEMBER_HR_NAME=Business Lead
MEMBER_SA_NAME=Solution Architect

# AI-sparringpartner (optioneel). Zonder sleutel werkt alles behalve de AI-functies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Zet op true als de app achter HTTPS draait
COOKIE_SECURE=false

# Waar de gegevens worden opgeslagen
# DATA_FILE=./data/brainstorm.json
